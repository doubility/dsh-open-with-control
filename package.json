{
  "name": "dsh-open-with-control",
  "version": "1.3.0",
  "type": "module",
  "description": "Control the session header's Open with menu: choose, order, and remove applications, pin a default, and add applications installed on this machine (macOS and Windows).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "open-with",
    "open-in-app",
    "applications"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "developer-apps.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.en.md",
    "LICENSE",
    "README.md",
    "screenshots.json",
    "assets/*.png"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doubility/dsh-open-with-control.git"
  },
  "homepage": "https://github.com/doubility/dsh-open-with-control#readme",
  "bugs": {
    "url": "https://github.com/doubility/dsh-open-with-control/issues"
  },
  "author": "sook"
}
